# Только отдельные тестовые боты. Секреты не публикуются в переписке.
TG_BOT_TOKEN=
MAX_BOT_TOKEN=
TG_BOT_USERNAME=max_tg_2sync_bot
MAX_BOT_USERNAME=se14620006_1_bot
# Дополнительный официальный корневой сертификат только для MAX, если нужен.
MAX_CA_FILE=.state/russian-root-ca.pem
# ID групп заполним после проверки ботов и поиска тестовых групп.
TG_CHAT_ID=
MAX_CHAT_ID=

# D5.1: управляемые SQLite/WAL/SHM и alerts; размеры в байтах.
STORAGE_WARN_BYTES=268435456
STORAGE_CRITICAL_BYTES=536870912
STORAGE_FREE_WARN_BYTES=268435456
STORAGE_FREE_CRITICAL_BYTES=134217728
# Секунды между измерениями приёма (1..60).
STORAGE_CHECK_INTERVAL=5
# Один текущий файл + 4 архива; 90 дней — верхняя граница истории файла.
ALERTS_MAX_BYTES=10485760
ALERTS_BACKUP_COUNT=4
ALERTS_RETENTION_DAYS=90
# Compose: размер /tmp каждого контейнера. После изменения выполнить make update.
BRIDGE_TMPFS_SIZE=64m
